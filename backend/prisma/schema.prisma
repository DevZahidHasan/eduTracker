generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String?
  name         String?
  role         Role     @default(TEACHER)
  nid          String?  @unique
  profileImage String?
  phone        String?
  address      String?
  canLogin     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  classSections     ClassSection[]
  periods           Period[]
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  questionPapers    QuestionPaper[]
  salary            StaffSalary?
  payrollRecords    PayrollRecord[]
  libraryMember     LibraryMember?
  driver            Driver?
  assignedInquiries Inquiry[]
  staffAttendances  StaffAttendance[]
  leaveRequests     LeaveRequest[]
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String // INFO, SUCCESS, WARNING, ERROR
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String // CREATE, UPDATE, DELETE
  entityType  String // Student, Mark, Attendance, etc.
  entityId    String // ID of the entity
  oldValue    Json? // Previous state
  newValue    Json? // New state
  performedBy Int // User ID who performed the action
  timestamp   DateTime @default(now())

  user User @relation(fields: [performedBy], references: [id])
}

enum Role {
  ADMIN
  PRINCIPAL
  TEACHER
  STAFF
  LIBRARIAN
  ACCOUNTANT
  CLERK
  SECURITY
  CLEANER
}

enum InquiryStatus {
  NEW
  CONTACTED
  INTERESTED
  NOT_INTERESTED
  ADMITTED
  REJECTED
}

enum InquirySource {
  WALK_IN
  PHONE
  WEBSITE
  FACEBOOK
  REFERENCE
  OTHER
}

model Inquiry {
  id              Int           @id @default(autoincrement())
  inquiryNumber   String        @unique // Auto-generated like INQ-2026-001
  studentName     String
  parentName      String
  phone           String
  email           String?
  interestedGrade String
  previousSchool  String?
  source          InquirySource @default(OTHER)
  status          InquiryStatus @default(NEW)
  notes           String?       @db.Text
  nextFollowUp    DateTime?

  assignedToId Int? // User ID handling this lead

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTo User? @relation(fields: [assignedToId], references: [id])
}

model Student {
  id            Int       @id @default(autoincrement())
  studentId     String    @unique
  fullName      String
  rollNumber    String
  className     String
  section       String
  gender        Gender
  email         String?   @unique
  dateOfBirth   DateTime?
  bloodGroup    String?
  phone         String?
  parentName    String?
  parentPhone   String?
  address       String?
  admissionDate DateTime  @default(now())
  profileImage  String?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  marks         Mark[]
  attendances   Attendance[]
  reports       AcademicReport[]
  termResults   TermResult[]
  vouchers      FeeVoucher[]
  payments      FeePayment[]
  class         SchoolClass      @relation(fields: [className], references: [name])
  classSection  ClassSection?    @relation(fields: [className, section], references: [className, section])
  libraryMember LibraryMember?
  busRoute      BusRoute?        @relation(fields: [busRouteId], references: [id])
  busRouteId    Int?
  busStop       BusStop?         @relation(fields: [busStopId], references: [id])
  busStopId     Int?

  @@unique([className, section, rollNumber])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model SchoolClass {
  name          String         @id
  students      Student[]
  sections      ClassSection[]
  feeStructures FeeStructure[]
}

model ClassSection {
  id        Int    @id @default(autoincrement())
  className String
  section   String // A, B, C
  teacherId Int? // Assigned class teacher for this section

  class    SchoolClass @relation(fields: [className], references: [name])
  teacher  User?       @relation(fields: [teacherId], references: [id])
  students Student[]
  routines Routine[]

  @@unique([className, section])
}

model Routine {
  id             Int       @id @default(autoincrement())
  classSectionId Int
  dayOfWeek      DayOfWeek
  periods        Period[]

  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  @@unique([classSectionId, dayOfWeek])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Period {
  id           Int    @id @default(autoincrement())
  routineId    Int
  subjectId    String
  teacherId    Int
  startTime    String // e.g. "08:00"
  endTime      String // e.g. "09:00"
  periodNumber Int? // e.g. 1, 2, 3

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [name])
  teacher User    @relation(fields: [teacherId], references: [id])
}

model Mark {
  id        Int      @id @default(autoincrement())
  studentId Int
  subject   String
  examType  String
  score     Float
  maxScore  Float    @default(100)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectObj  Subject  @relation(fields: [subject], references: [name])
  examTypeObj ExamType @relation(fields: [examType], references: [name])

  @@unique([studentId, subject, examType, date])
}

model Subject {
  name    String   @id
  marks   Mark[]
  periods Period[]
}

model ExamType {
  name     String           @id
  baseMark Float            @default(100)
  marks    Mark[]
  reports  AcademicReport[]
}

model MarkLock {
  id        Int      @id @default(autoincrement())
  className String
  subject   String
  examType  String
  date      DateTime @default(now())
  lockedAt  DateTime @default(now())
  lockedBy  Int

  @@unique([className, subject, examType, date])
}

model AcademicReport {
  id             Int      @id @default(autoincrement())
  studentId      Int
  examType       String
  gpa            Float?
  teacherRemarks String?
  aiInsights     String?
  attendanceRate Float?
  generatedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examTypeObj ExamType @relation(fields: [examType], references: [name])

  @@unique([studentId, examType])
}

model Attendance {
  id        Int              @id @default(autoincrement())
  studentId Int
  date      DateTime         @default(now())
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model SchoolProfile {
  id           Int      @id @default(1)
  name         String   @default("EduTrack Academy")
  address      String?
  phone        String?
  email        String?
  website      String?
  academicYear String   @default("2026-2027")
  logo         String?
  updatedAt    DateTime @updatedAt
}

model SystemSetting {
  key   String @id
  value String
}

enum QuestionPaperStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model QuestionPaper {
  id           String              @id @default(uuid())
  title        String
  className    String
  section      String?
  subject      String
  examType     String
  totalMarks   Int
  duration     Int
  examDate     DateTime?
  instructions String?
  status       QuestionPaperStatus @default(DRAFT)
  isTemplate   Boolean             @default(false)
  templateId   String?
  createdBy    Int
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user          User            @relation(fields: [createdBy], references: [id])
  questions     Question[]
  template      QuestionPaper?  @relation("TemplateToPaper", fields: [templateId], references: [id])
  derivedPapers QuestionPaper[] @relation("TemplateToPaper")

  @@index([className, subject])
  @@index([examDate])
}

model Question {
  id              String   @id @default(uuid())
  questionPaperId String
  questionType    String
  questionText    String
  marks           Int
  order           Int
  options         String[]
  correctAnswer   String?
  instructions    String?

  questionPaper QuestionPaper @relation(fields: [questionPaperId], references: [id], onDelete: Cascade)

  @@index([questionPaperId])
}

model BankQuestion {
  id            String   @id @default(uuid())
  className     String
  subject       String
  chapter       String?
  questionType  String
  questionText  String
  marks         Int
  options       String[]
  correctAnswer String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([className, subject])
}

// --- Financial Models ---

model FeeType {
  id        Int      @id @default(autoincrement())
  name      String   @unique // Tuition, Exam, Transport, etc.
  isMonthly Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  structures   FeeStructure[]
  voucherItems FeeVoucherItem[]
}

model FeeStructure {
  id        Int    @id @default(autoincrement())
  className String
  feeTypeId Int
  amount    Float

  class   SchoolClass @relation(fields: [className], references: [name])
  feeType FeeType     @relation(fields: [feeTypeId], references: [id])

  @@unique([className, feeTypeId])
}

model FeeVoucher {
  id          String   @id @default(uuid())
  studentId   Int
  month       Int // 1-12
  year        Int
  dueDate     DateTime
  totalAmount Float
  paidAmount  Float    @default(0)
  status      String   @default("UNPAID") // UNPAID, PARTIAL, PAID, OVERDUE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student  Student          @relation(fields: [studentId], references: [id])
  items    FeeVoucherItem[]
  payments FeePayment[]
}

model FeeVoucherItem {
  id        Int    @id @default(autoincrement())
  voucherId String
  feeTypeId Int
  amount    Float

  voucher FeeVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  feeType FeeType    @relation(fields: [feeTypeId], references: [id])
}

model FeePayment {
  id            String   @id @default(uuid())
  voucherId     String
  studentId     Int
  amount        Float
  paymentDate   DateTime @default(now())
  paymentMethod String // CASH, BANK_TRANSFER, ONLINE
  transactionId String?
  receivedBy    Int // User ID (Accountant/Admin)

  voucher FeeVoucher @relation(fields: [voucherId], references: [id])
  student Student    @relation(fields: [studentId], references: [id])
}

// --- HR & Payroll Models ---

model StaffSalary {
  userId     Int   @id
  baseSalary Float
  allowances Float @default(0)
  deductions Float @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PayrollRecord {
  id            String   @id @default(uuid())
  userId        Int
  month         Int
  year          Int
  baseSalary    Float
  allowances    Float    @default(0)
  deductions    Float    @default(0)
  netPay        Float
  paymentDate   DateTime @default(now())
  status        String   @default("PAID") // PAID, PENDING
  paymentMethod String?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, month, year])
}

model StaffAttendance {
  id      Int              @id @default(autoincrement())
  userId  Int
  date    DateTime
  status  AttendanceStatus
  remarks String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id        Int         @id @default(autoincrement())
  userId    Int
  startDate DateTime
  endDate   DateTime
  reason    String      @db.Text
  status    LeaveStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Enhanced Academic Models ---

model GradeScale {
  id       Int    @id @default(autoincrement())
  grade    String // A+, A, B, etc.
  minScore Float
  maxScore Float
  points   Float // 4.0
}

model TermResult {
  id             Int      @id @default(autoincrement())
  studentId      Int
  examType       String
  totalMarks     Float
  obtainedMarks  Float
  percentage     Float
  grade          String?
  gpa            Float?
  position       Int?
  teacherRemarks String?
  status         String   @default("FINAL") // DRAFT, FINAL
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// --- Library Management Models ---

model Book {
  id              Int      @id @default(autoincrement())
  isbn            String?  @unique
  title           String
  author          String
  publisher       String?
  category        String
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  location        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  issues BookIssue[]
}

model LibraryMember {
  id        Int      @id @default(autoincrement())
  memberId  String   @unique // System generated or manual barcode
  studentId Int?     @unique
  userId    Int?     @unique
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  issues  BookIssue[]
}

model BookIssue {
  id         Int       @id @default(autoincrement())
  bookId     Int
  memberId   Int
  issueDate  DateTime  @default(now())
  dueDate    DateTime
  returnDate DateTime?
  status     String    @default("ISSUED") // ISSUED, RETURNED, OVERDUE
  fineAmount Float     @default(0)
  notes      String?

  book   Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  member LibraryMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

// --- Transport & Fleet Management Models ---

model Vehicle {
  id                 Int       @id @default(autoincrement())
  vehicleId          String    @unique // System generated unique ID (e.g. VH-1001)
  registrationNumber String    @unique
  make               String?
  model              String?
  capacity           Int       @default(0)
  status             String    @default("ACTIVE") // ACTIVE, MAINTENANCE, RETIRED
  insuranceExpiry    DateTime?
  nextServiceDate    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  routes          BusRoute[]
  maintenanceLogs VehicleMaintenance[]
}

model Driver {
  id            Int      @id @default(autoincrement())
  driverId      String   @unique // System generated unique ID (e.g. DR-1001)
  name          String
  userId        Int?     @unique
  licenseNumber String   @unique
  phone         String?
  status        String   @default("ACTIVE") // ACTIVE, ON_LEAVE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  routes BusRoute[]
}

model BusRoute {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  vehicleId   Int?
  driverId    Int?
  fare        Float    @default(0) // Default monthly fare
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver   Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  stops    BusStop[]
  students Student[]
}

model BusStop {
  id         Int     @id @default(autoincrement())
  routeId    Int
  name       String
  pickupTime String?
  dropTime   String?
  fare       Float? // Optional override for specific stop fare

  route    BusRoute  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  students Student[]
}

model VehicleMaintenance {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  date        DateTime @default(now())
  description String
  cost        Float    @default(0)
  type        String   @default("SERVICE") // SERVICE, REPAIR, INSPECTION
  reportedBy  String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}
