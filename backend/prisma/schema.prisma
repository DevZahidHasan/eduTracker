generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int               @id @default(autoincrement())
  email             String            @unique
  password          String?
  name              String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  address           String?
  canLogin          Boolean           @default(true)
  nid               String?           @unique
  phone             String?
  profileImage      String?
  role              String            @default("TEACHER")
  roleRef           Role              @relation(fields: [role], references: [name])
  auditLogs         AuditLog[]
  classSections     ClassSection[]
  driver            Driver?
  assignedInquiries Inquiry[]
  leaveRequests     LeaveRequest[]
  libraryMember     LibraryMember?
  notifications     Notification[]
  payrollRecords    PayrollRecord[]
  periods           Period[]
  questionPapers    QuestionPaper[]
  refreshTokens     RefreshToken[]
  staffAttendances  StaffAttendance[]
  salary            StaffSalary?
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String
  entityType  String
  entityId    String
  oldValue    Json?
  newValue    Json?
  performedBy Int
  timestamp   DateTime @default(now())
  user        User     @relation(fields: [performedBy], references: [id])
}

model Inquiry {
  id              Int           @id @default(autoincrement())
  inquiryNumber   String        @unique
  studentName     String
  parentName      String
  phone           String
  email           String?
  interestedGrade String
  previousSchool  String?
  source          InquirySource @default(OTHER)
  status          InquiryStatus @default(NEW)
  notes           String?
  nextFollowUp    DateTime?
  assignedToId    Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  assignedTo      User?         @relation(fields: [assignedToId], references: [id])
}

model Student {
  id            Int              @id @default(autoincrement())
  studentId     String           @unique
  email         String?
  dateOfBirth   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  address       String?
  admissionDate DateTime         @default(now())
  bloodGroup    String?
  fullName      String
  gender        Gender
  parentName    String?
  parentPhone   String?
  phone         String?
  profileImage  String?
  rollNumber    String
  section       String
  className     String
  busRouteId    Int?
  busStopId     Int?
  reports       AcademicReport[]
  attendances   Attendance[]
  payments      FeePayment[]
  vouchers      FeeVoucher[]
  libraryMember LibraryMember?
  marks         Mark[]
  busRoute      BusRoute?        @relation(fields: [busRouteId], references: [id])
  busStop       BusStop?         @relation(fields: [busStopId], references: [id])
  class         SchoolClass      @relation(fields: [className], references: [name])
  classSection  ClassSection     @relation(fields: [className, section], references: [className, section])
  termResults   TermResult[]

  @@unique([className, section, rollNumber])
}

model SchoolClass {
  name          String         @id
  sections      ClassSection[]
  feeStructures FeeStructure[]
  students      Student[]
}

model ClassSection {
  id        Int         @id @default(autoincrement())
  className String
  section   String
  teacherId Int?
  class     SchoolClass @relation(fields: [className], references: [name])
  teacher   User?       @relation(fields: [teacherId], references: [id])
  routines  Routine[]
  students  Student[]

  @@unique([className, section])
}

model Routine {
  id             Int          @id @default(autoincrement())
  classSectionId Int
  dayOfWeek      DayOfWeek
  periods        Period[]
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  @@unique([classSectionId, dayOfWeek])
}

model Period {
  id           Int     @id @default(autoincrement())
  routineId    Int
  subjectId    String
  teacherId    Int
  startTime    String
  endTime      String
  periodNumber Int?
  routine      Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  subject      Subject @relation(fields: [subjectId], references: [name])
  teacher      User    @relation(fields: [teacherId], references: [id])
}

model Mark {
  id          Int      @id @default(autoincrement())
  studentId   Int
  subject     String
  score       Float
  maxScore    Float    @default(100)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  examType    String
  examTypeObj ExamType @relation(fields: [examType], references: [name])
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectObj  Subject  @relation(fields: [subject], references: [name])

  @@unique([studentId, subject, examType, date])
}

model Subject {
  name    String   @id
  marks   Mark[]
  periods Period[]
}

model ExamType {
  name     String           @id
  baseMark Float            @default(100)
  reports  AcademicReport[]
  marks    Mark[]
}

model MarkLock {
  id        Int      @id @default(autoincrement())
  className String
  subject   String
  examType  String
  lockedAt  DateTime @default(now())
  lockedBy  Int
  date      DateTime @default(now())

  @@unique([className, subject, examType, date])
}

model AcademicReport {
  id             Int      @id @default(autoincrement())
  studentId      Int
  examType       String
  gpa            Float?
  teacherRemarks String?
  aiInsights     String?
  attendanceRate Float?
  generatedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
  examTypeObj    ExamType @relation(fields: [examType], references: [name])
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, examType])
}

model Attendance {
  id        Int              @id @default(autoincrement())
  studentId Int
  date      DateTime         @default(now())
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
}

model SchoolProfile {
  id           Int      @id @default(1)
  name         String   @default("EduTrack Academy")
  address      String?
  phone        String?
  email        String?
  academicYear String   @default("2026-2027")
  logo         String?
  signature    String? // Path to principal's signature
  updatedAt    DateTime @updatedAt
  website      String?
}

// --- ID Card & Certificate Templates ---

model DocumentTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  type        String // ID_CARD, LEAVING_CERTIFICATE, CHARACTER_CERTIFICATE
  config      Json // Stores colors, layout settings, background image, etc.
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  key   String @id
  value String
}

model QuestionPaper {
  id            String              @id @default(uuid())
  title         String
  className     String
  section       String?
  subject       String
  examType      String
  totalMarks    Int
  duration      Int
  examDate      DateTime?
  createdBy     Int
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  instructions  String?
  status        QuestionPaperStatus @default(DRAFT)
  isTemplate    Boolean             @default(false)
  templateId    String?
  questions     Question[]
  user          User                @relation(fields: [createdBy], references: [id])
  template      QuestionPaper?      @relation("TemplateToPaper", fields: [templateId], references: [id])
  derivedPapers QuestionPaper[]     @relation("TemplateToPaper")

  @@index([className, subject])
  @@index([examDate])
}

model Question {
  id              String        @id @default(uuid())
  questionPaperId String
  questionType    String
  questionText    String
  marks           Int
  order           Int
  correctAnswer   String?
  instructions    String?
  options         String[]
  questionPaper   QuestionPaper @relation(fields: [questionPaperId], references: [id], onDelete: Cascade)

  @@index([questionPaperId])
}

model BankQuestion {
  id            String   @id @default(uuid())
  className     String
  subject       String
  chapter       String?
  questionType  String
  questionText  String
  marks         Int
  options       String[]
  correctAnswer String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([className, subject])
}

model FeeType {
  id           Int              @id @default(autoincrement())
  name         String           @unique
  isMonthly    Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  structures   FeeStructure[]
  voucherItems FeeVoucherItem[]
}

model FeeStructure {
  id        Int         @id @default(autoincrement())
  className String
  feeTypeId Int
  amount    Float
  class     SchoolClass @relation(fields: [className], references: [name])
  feeType   FeeType     @relation(fields: [feeTypeId], references: [id])

  @@unique([className, feeTypeId])
}

model FeeVoucher {
  id          String           @id @default(uuid())
  studentId   Int
  month       Int
  year        Int
  dueDate     DateTime
  totalAmount Float
  paidAmount  Float            @default(0)
  status      String           @default("UNPAID")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  payments    FeePayment[]
  student     Student          @relation(fields: [studentId], references: [id])
  items       FeeVoucherItem[]
}

model FeeVoucherItem {
  id        Int        @id @default(autoincrement())
  voucherId String
  feeTypeId Int
  amount    Float
  feeType   FeeType    @relation(fields: [feeTypeId], references: [id])
  voucher   FeeVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
}

model FeePayment {
  id            String     @id @default(uuid())
  voucherId     String
  studentId     Int
  amount        Float
  paymentDate   DateTime   @default(now())
  paymentMethod String
  transactionId String?
  receivedBy    Int
  student       Student    @relation(fields: [studentId], references: [id])
  voucher       FeeVoucher @relation(fields: [voucherId], references: [id])
}

model StaffSalary {
  userId     Int   @id
  baseSalary Float
  allowances Float @default(0)
  deductions Float @default(0)
  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PayrollRecord {
  id            String   @id @default(uuid())
  userId        Int
  month         Int
  year          Int
  paymentDate   DateTime @default(now())
  status        String   @default("PAID")
  allowances    Float    @default(0)
  baseSalary    Float
  deductions    Float    @default(0)
  netPay        Float
  paymentMethod String?
  user          User     @relation(fields: [userId], references: [id])

  @@unique([userId, month, year])
}

model StaffAttendance {
  id      Int              @id @default(autoincrement())
  userId  Int
  date    DateTime
  status  AttendanceStatus
  remarks String?
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model LeaveRequest {
  id        Int         @id @default(autoincrement())
  userId    Int
  startDate DateTime
  endDate   DateTime
  reason    String
  status    LeaveStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GradeScale {
  id       Int    @id @default(autoincrement())
  grade    String
  minScore Float
  maxScore Float
  points   Float
}

model TermResult {
  id             Int      @id @default(autoincrement())
  studentId      Int
  examType       String
  totalMarks     Float
  obtainedMarks  Float
  percentage     Float
  grade          String?
  gpa            Float?
  position       Int?
  teacherRemarks String?
  status         String   @default("FINAL")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Book {
  id              Int         @id @default(autoincrement())
  isbn            String?     @unique
  title           String
  author          String
  publisher       String?
  category        String
  totalCopies     Int         @default(1)
  availableCopies Int         @default(1)
  location        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  issues          BookIssue[]
}

model LibraryMember {
  id        Int         @id @default(autoincrement())
  memberId  String      @unique
  studentId Int?        @unique
  userId    Int?        @unique
  status    String      @default("ACTIVE")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  issues    BookIssue[]
  student   Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BookIssue {
  id         Int           @id @default(autoincrement())
  bookId     Int
  memberId   Int
  issueDate  DateTime      @default(now())
  dueDate    DateTime
  returnDate DateTime?
  status     String        @default("ISSUED")
  fineAmount Float         @default(0)
  notes      String?
  book       Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  member     LibraryMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id                 Int                  @id @default(autoincrement())
  registrationNumber String               @unique
  make               String?
  model              String?
  capacity           Int                  @default(0)
  status             String               @default("ACTIVE")
  insuranceExpiry    DateTime?
  nextServiceDate    DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  vehicleId          String               @unique
  routes             BusRoute[]
  maintenanceLogs    VehicleMaintenance[]
}

model Driver {
  id            Int        @id @default(autoincrement())
  userId        Int?       @unique
  licenseNumber String     @unique
  phone         String?
  status        String     @default("ACTIVE")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  driverId      String     @unique
  name          String
  routes        BusRoute[]
  user          User?      @relation(fields: [userId], references: [id])
}

model BusRoute {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  vehicleId   Int?
  driverId    Int?
  fare        Float     @default(0)
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  driver      Driver?   @relation(fields: [driverId], references: [id])
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id])
  stops       BusStop[]
  students    Student[]
}

model BusStop {
  id         Int       @id @default(autoincrement())
  routeId    Int
  name       String
  pickupTime String?
  dropTime   String?
  fare       Float?
  route      BusRoute  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  students   Student[]
}

model VehicleMaintenance {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  date        DateTime @default(now())
  description String
  cost        Float    @default(0)
  type        String   @default("SERVICE")
  reportedBy  String?
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Asset {
  id                  Int                @id @default(autoincrement())
  assetId             String             @unique
  name                String
  category            String
  purchaseDate        DateTime?
  purchaseCost        Float?
  condition           AssetCondition     @default(NEW)
  location            String?
  status              AssetStatus        @default(ACTIVE)
  serialNumber        String?            @unique
  warrantyExpiry      DateTime?
  nextMaintenanceDate DateTime?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  maintenanceLogs     AssetMaintenance[]
}

model AssetMaintenance {
  id          Int      @id @default(autoincrement())
  assetId     Int
  date        DateTime @default(now())
  description String
  cost        Float    @default(0)
  performedBy String?
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

enum InquiryStatus {
  NEW
  CONTACTED
  INTERESTED
  NOT_INTERESTED
  ADMITTED
  REJECTED
}

enum InquirySource {
  WALK_IN
  PHONE
  WEBSITE
  FACEBOOK
  REFERENCE
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum QuestionPaperStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  BROKEN
}

enum AssetStatus {
  ACTIVE
  IN_REPAIR
  SCRAPPED
  DISPOSED
  LOST
}
