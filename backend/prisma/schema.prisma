generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(TEACHER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classSections ClassSection[]
  periods       Period[]
}

enum Role {
  ADMIN
  TEACHER
}

model Student {
  id             Int       @id @default(autoincrement())
  studentId      String    @unique
  fullName       String
  rollNumber     String
  className      String
  section        String
  gender         Gender
  email          String?   @unique
  dateOfBirth    DateTime?
  bloodGroup     String?
  phone          String?
  parentName     String?
  parentPhone    String?
  address        String?
  admissionDate  DateTime  @default(now())
  profileImage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  marks          Mark[]
  attendances    Attendance[]
  reports        AcademicReport[]
  class          SchoolClass  @relation(fields: [className], references: [name])
  classSection   ClassSection? @relation(fields: [className, section], references: [className, section])

  @@unique([className, section, rollNumber])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model SchoolClass {
  name     String    @id
  students Student[]
  sections ClassSection[]
}

model ClassSection {
  id        Int      @id @default(autoincrement())
  className String
  section   String   // A, B, C
  teacherId Int?     // Assigned class teacher for this section
  
  class     SchoolClass @relation(fields: [className], references: [name])
  teacher   User?       @relation(fields: [teacherId], references: [id])
  students  Student[]
  routines  Routine[]

  @@unique([className, section])
}

model Routine {
  id             Int          @id @default(autoincrement())
  classSectionId Int
  dayOfWeek      DayOfWeek
  periods        Period[]
  
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  @@unique([classSectionId, dayOfWeek])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Period {
  id        Int      @id @default(autoincrement())
  routineId Int
  subjectId String
  teacherId Int
  startTime String   // e.g. "08:00"
  endTime   String   // e.g. "09:00"
  periodNumber Int?  // e.g. 1, 2, 3
  
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [name])
  teacher   User     @relation(fields: [teacherId], references: [id])
}

model Mark {
  id        Int      @id @default(autoincrement())
  studentId Int
  subject   String
  examType  String
  score     Float
  maxScore  Float    @default(100)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectObj  Subject  @relation(fields: [subject], references: [name])
  examTypeObj ExamType @relation(fields: [examType], references: [name])

  @@unique([studentId, subject, examType])
}

model Subject {
  name    String   @id
  marks   Mark[]
  periods Period[]
}

model ExamType {
  name    String           @id
  marks   Mark[]
  reports AcademicReport[]
}

model AcademicReport {
  id           Int      @id @default(autoincrement())
  studentId    Int
  examType     String
  gpa          Float?
  teacherRemarks String?
  aiInsights   String?
  attendanceRate Float?
  generatedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examTypeObj ExamType @relation(fields: [examType], references: [name])

  @@unique([studentId, examType])
}

model Attendance {
  id        Int              @id @default(autoincrement())
  studentId Int
  date      DateTime         @default(now())
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}
